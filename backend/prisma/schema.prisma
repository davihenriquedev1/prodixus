// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings  UserSettings?
  projects  Project[]

  tags      Tag[]
  folders   Folder[]
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  theme     String   @default("system")
  language  String   @default("en-US")
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                String   @id @default(uuid())
  name              String
  notes             String?
  completed         Boolean  @default(false)
  archived          Boolean  @default(false)
  estimatedDuration Int?
  dueAt             DateTime?
  userId            String
  primaryColor      String?
  accentColor       String?
  errorColor        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks             Task[]
  folderId          String?

  folder            Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
}

model Task {
  id                String   @id @default(uuid())
  title             String
  notes             String?
  archived          Boolean  @default(false)
  priority          Int      @default(0)
  completed         Boolean  @default(false)
  estimatedDuration Int?
  startAt           DateTime?
  dueAt             DateTime?
  projectId         String
  parentTaskId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask        Task?    @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks          Task[]   @relation("Subtasks")
  taskTags          TaskTag[]
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags  TaskTag[]

  @@unique([userId, name]) // Composite uniqueness constraint. The Tag name is unique within the user scope, not globally.
}

model TaskTag {
  taskId    String
  tagId     String

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId]) // Composite primary key. The combination of taskId and tagId identifies a unique association.
}

model Folder {
  id         String   @id @default(uuid())
  name       String
  userId     String
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Folder?  @relation("Subfolders", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders Folder[] @relation("Subfolders")
  projects   Project[]
}