// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  settings UserSettings?
  projects Project[]

  tags          Tag[]
  folders       Folder[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  theme     String   @default("system")
  language  String   @default("en-US")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id                String    @id @default(uuid())
  name              String
  notes             String?
  completed         Boolean   @default(false)
  archived          Boolean   @default(false)
  estimatedDuration Int?      @map("estimated_duration")
  dueAt             DateTime? @map("due_at")
  primaryColor      String?   @map("primary_color")
  accentColor       String?   @map("accent_color")
  errorColor        String?   @map("error_color")
  userId            String    @map("user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  folderId          String?   @map("folder_id")

  tasks  Task[]
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@map("projects")
}

model Task {
  id                String    @id @default(uuid())
  title             String
  notes             String?
  priority          Int       @default(0)
  estimatedDuration Int?      @map("estimated_duration")
  startAt           DateTime? @map("start_at")
  dueAt             DateTime? @map("due_at")
  completed         Boolean   @default(false)
  archived          Boolean   @default(false)
  projectId         String    @map("project_id")
  parentId          String?   @map("parent_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks   Task[]    @relation("Subtasks")
  taskTags   TaskTag[]

  @@map("tasks")
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags TaskTag[]

  @@unique([userId, name]) // Composite uniqueness constraint. The Tag name is unique within the user scope, not globally.
  @@map("tags")
}

model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId]) // Composite primary key. The combination of taskId and tagId identifies a unique association.
  @@map("task_tags")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Folder?   @relation("Subfolders", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders Folder[]  @relation("Subfolders")
  projects   Project[]

  @@map("folders")
}
